# Build the test app with the upstream Angular CLI (`ng build`).
#
# Build context is the workspace root (for parity with Dockerfile). Invoke:
#   docker build -f test/test-ng-project/Dockerfile.ng -t ng-test .
#
# Or use the helper:
#   test/test-ng-project/docker-build-ng.sh

FROM node:24 AS build
WORKDIR /app
COPY test/test-ng-project/package.json test/test-ng-project/package-lock.json ./
RUN npm ci
COPY test/test-ng-project/ ./
RUN npx ng build --configuration production

FROM nginx:1.29-alpine-slim
RUN addgroup -S appgroup && adduser -S appuser -G appgroup \
  && chown -R appuser:appgroup /usr/share/nginx/html \
  && chown -R appuser:appgroup /var/cache/nginx \
  && chown -R appuser:appgroup /var/log/nginx \
  && touch /var/run/nginx.pid && chown appuser:appgroup /var/run/nginx.pid
RUN rm -f /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/test-ng-project/browser /usr/share/nginx/html
COPY test/test-ng-project/nginx.conf /etc/nginx/conf.d/default.conf
USER appuser
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
